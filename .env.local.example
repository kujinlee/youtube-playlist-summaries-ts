# Path to the shared data folder (manifest.json, video-summaries/, _pdf/, etc.)
# Defaults to the sibling data folder if not set.
DATA_ROOT=/Users/kujinlee/code/agentic-ai-docs/youtube-playlist-summaries-data

# Gemini API key — get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_key_here

# Obsidian vault name — defaults to the last path component of DATA_ROOT.
# Override if your vault was opened with a different name in Obsidian.
# OBSIDIAN_VAULT=youtube-playlist-summaries-data

# Folder prefix in obsidian:// file paths. Defaults to "video-summaries".
# Set to empty if your vault root IS the video-summaries folder.
# OBSIDIAN_FILE_PREFIX=
